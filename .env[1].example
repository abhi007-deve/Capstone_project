# AI Provider Configuration
# FinLoan AI supports Anthropic Claude API as requested, and also Google Gemini API.
# If ANTHROPIC_API_KEY is provided, Claude 3.5 Sonnet is used for AI analysis.
# If only GEMINI_API_KEY is provided, Gemini 2.5 Flash is used.
# If neither key is provided, the platform automatically runs in "Demo Mode" with high-precision financial algorithms.
ANTHROPIC_API_KEY="sk-ant-api03-..."
GEMINI_API_KEY="AIzaSy..."

# Google Sheets Integration
# Service account email and private key to persist user loan records directly into a Google Spreadsheet
GOOGLE_SERVICE_ACCOUNT_EMAIL="finloan-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms"

# Server & Runtime Configuration
PORT=3000
NODE_ENV="development"
APP_URL="MY_APP_URL"

